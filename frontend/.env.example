# Copia a .env.local (ignorado por git). Sin VITE_API_URL el front arranca en MODO DEMO
# (datos de contracts/fixtures/seed + simulación del golden path), sin AWS ni GCP.
# Todo lo de este archivo es PÚBLICO (viaja al navegador). Nunca pongas secretos aquí.

# --- API real (API Gateway, stage v1). Las rutas NO llevan /v1: el front llama ${VITE_API_URL}/me, /machines…
# Ej.: https://abc123.execute-api.us-east-1.amazonaws.com/v1   (output de infra/base, B)
VITE_API_URL=

# --- Cognito (lo crea B en infra/base). App client con ALLOW_USER_PASSWORD_AUTH y SIN secret.
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_CLIENT_ID=

# --- Firebase (config PÚBLICA de la app web: Firebase > Configuración del proyecto > Tus apps). No es un secreto.
# Si falta, el tiempo real cae a polling de la API cada 10 s y el chat queda deshabilitado.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Push web FCM (RF-16). Firebase > Configuración del proyecto > Cloud Messaging:
#   SENDER_ID = "ID del remitente"; VAPID_KEY = "Certificados push web" > par de claves (clave pública).
# Si faltan, no se registra push (el resto funciona igual).
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=

# --- Forzar modo demo aunque haya API (útil para ensayar el pitch)
VITE_FORCE_DEMO=false
