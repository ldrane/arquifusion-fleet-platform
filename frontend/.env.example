# Copia a .env.local (ignorado por git). Sin VITE_API_URL el front arranca en MODO DEMO
# (datos de contracts/fixtures/seed + simulación del golden path), sin AWS ni GCP.

# --- API real (API Gateway, stage v1). Ej.: https://abc123.execute-api.us-east-1.amazonaws.com/v1
VITE_API_URL=

# --- Cognito (lo crea B en infra/base). App client con ALLOW_USER_PASSWORD_AUTH y SIN secret.
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_CLIENT_ID=

# --- Firebase (config PÚBLICA de la app web: Firebase > Configuración > Tus apps). No es un secreto.
# Si falta, el tiempo real cae a polling de la API cada 10 s y el chat queda deshabilitado.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Forzar modo demo aunque haya API (útil para ensayar el pitch)
VITE_FORCE_DEMO=false
